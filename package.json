{
    "name": "windy-plugin-fishing-assistant",
    "version": "1.1.0",
    "description": "A weather assistant for anglers: current & future fishing index, conditions, prime time, waves and alerts — as a Windy plugin. English & 简体中文.",
    "main": "dist/plugin.min.js",
    "type": "module",
    "files": [
        "plugin.json",
        "plugin.min.js",
        "plugin.js",
        "screenshot.png"
    ],
    "scripts": {
        "prebuild": "node scripts/sync-version.mjs",
        "build": "node scripts/build.mjs",
        "start": "rollup -w -c",
        "lint": "eslint . --ext .ts,.svelte",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "version:sync": "node scripts/sync-version.mjs",
        "version:check": "node scripts/sync-version.mjs --check",
        "verify": "npm run version:check && npm run lint && npm run check && npm test",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HarryChen-10086/windy-plugin-fishing-assistant.git"
    },
    "keywords": [
        "windy",
        "windy.com",
        "plugin",
        "fishing",
        "angler",
        "weather"
    ],
    "author": "HarryChen-10086",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/HarryChen-10086/windy-plugin-fishing-assistant/issues"
    },
    "homepage": "https://github.com/HarryChen-10086/windy-plugin-fishing-assistant",
    "dependencies": {},
    "devDependencies": {
        "@rollup/plugin-commonjs": "^25.0.8",
        "@rollup/plugin-node-resolve": "^15.3.1",
        "@rollup/plugin-terser": "^0.4.4",
        "@swc/core": "^1.16.18",
        "@types/node": "^22.20.5",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "@windycom/plugin-devtools": "^3.0.3",
        "eslint": "^8.57.1",
        "eslint-import-resolver-typescript": "^3.10.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-svelte": "^2.46.1",
        "less": "^4.9.1",
        "rollup": "^4.64.9",
        "rollup-plugin-cleanup": "^3.2.1",
        "rollup-plugin-serve": "^1.1.1",
        "rollup-plugin-svelte": "^7.2.3",
        "rollup-plugin-swc3": "^0.11.2",
        "svelte": "^4.2.20",
        "svelte-check": "^4.7.7",
        "svelte-eslint-parser": "^0.43.0",
        "svelte-preprocess": "^5.1.4",
        "svelte-preprocess-less": "^0.4.0",
        "typescript": "^5.9.3",
        "vitest": "^3.2.7"
    }
}
